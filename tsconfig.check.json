{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@prisma/client": ["node_modules/@prisma/client"]
    }
  },
  "include": [
    "src/services/snapCalculator.js",
    "src/services/dataValidator.js",
    "src/services/consistencyChecker.js",
    "src/services/aiResponseValidator.js",
    "src/services/dbRetry.js",
    "src/services/logger.js"
  ],
  "exclude": ["node_modules"]
}
