# ╔══════════════════════════════════════════════════════════════════╗
# ║  Cushion Gov — Environment Configuration                       ║
# ║  SNAP Payment Accuracy Platform for County DFCS Offices        ║
# ╚══════════════════════════════════════════════════════════════════╝

# ── Database ─────────────────────────────────────────────────────
# Format: postgresql://[username]:[password]@[host]:[port]/[database]
# IMPORTANT: For remote databases, add ?sslmode=require for TLS
# Production: Load from Secrets Manager, NOT from .env file
# Example (AWS RDS): postgresql://admin:pw@cushion.xxxxx.rds.amazonaws.com:5432/cushion_gov?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/cushion_gov"

# ── AI Provider (Primary) ───────────────────────────────────────
# SECRET: Anthropic API key for Claude integration
# Get from: https://console.anthropic.com/account/keys
# Format: sk-ant-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# Production: Load from Secrets Manager
ANTHROPIC_API_KEY="sk-ant-..."

# ── Authentication ───────────────────────────────────────────────
# SECRET: JWT signing key for caseworker session tokens
# MUST be ≥32 random characters. Generate with: openssl rand -base64 32
# If compromised: ALL active sessions become exploitable — rotate immediately
# Production: Load from Secrets Manager
JWT_SECRET="your-secret-here"

# ── Environment ──────────────────────────────────────────────────
# Controls: logging verbosity, security validation strictness, TLS requirements
# Values: development | test | production
# Production enforces: HTTPS CORS, Redis sessions, stricter validation
NODE_ENV="development"

# ── Network Access Control ───────────────────────────────────────
# Comma-separated CIDR ranges restricting API access (county VPN/Wi-Fi)
# Examples: "10.0.0.0/8,192.168.1.0/24,172.16.0.0/12"
# If unset: allows all in development, warns in production
# Get from: County IT — ask for their network CIDR ranges
ALLOWED_IP_RANGES=""

# ── Kiosk Authentication ─────────────────────────────────────────
# Comma-separated SHA-256 hashes of staff PINs for kiosk access
# Generate hash: echo -n "1234" | sha256sum | cut -d' ' -f1
# Each staff member should have a unique PIN
# To revoke: remove the hash from this list and restart
# If unset: allows all in development, blocks all in production
KIOSK_STAFF_PINS=""

# ── AI Provider (Fallback) ───────────────────────────────────────
# Optional: Enables automatic failover if Claude API is unavailable
# Get from: https://platform.openai.com/account/api-keys
# If set: System automatically switches to OpenAI on Claude failures
# If unset: No failover — system returns error if Claude is down
OPENAI_API_KEY=""

# ── AI Failover Tuning ──────────────────────────────────────────
# Consecutive failures before switching to fallback provider
AI_FAILOVER_THRESHOLD="3"
# Milliseconds before retrying primary provider after failover
AI_FAILOVER_RESET_MS="60000"

# ── Session Store ────────────────────────────────────────────────
# Redis URL for production session persistence
# Format: redis://[password@]host:port/database
# REQUIRED in production — in-memory sessions are lost on restart
# AWS: Use ElastiCache (encryption in transit enabled)
# If unset: Uses in-memory store (development only)
REDIS_URL=""

# ── Session Configuration ────────────────────────────────────────
# Session timeout in milliseconds (default: 30 minutes)
# Applicants are warned 5 minutes before expiration
SESSION_TTL_MS="1800000"

# ── CORS ─────────────────────────────────────────────────────────
# Frontend domain for cross-origin requests
# MUST be specific HTTPS domain in production (not * or localhost)
# Example: https://cushion-intake.dfcs.ga.gov
# Misconfiguration risk: wildcard "*" disables CORS protection
CORS_ORIGIN=""

# ── Logging ──────────────────────────────────────────────────────
# Values: error | warn | info | debug
# Development: "debug" (most verbose)
# Production: "info" or "warn" (minimal logging, better performance)
LOG_LEVEL="info"

# ── Server ───────────────────────────────────────────────────────
PORT="3000"

# ── Secrets Manager (Production) ─────────────────────────────────
# Use a secrets manager instead of .env file in production
# Values: aws | azure | vault | (omit for .env-based config)
# If "aws": Uses AWS Secrets Manager for DATABASE_URL, API keys, JWT_SECRET
# If "azure": Uses Azure Key Vault
# If "vault": Uses HashiCorp Vault
SECRETS_MANAGER=""

# ── Data Retention ───────────────────────────────────────────────
# Days to retain completed intakes (default: 2555 = 7 years per SNAP regulation)
INTAKE_RETENTION_DAYS="2555"
# Days to retain conversation logs after review (default: 90)
CONVERSATION_LOG_RETENTION_DAYS="90"
