DATABASE_URL="postgresql://user:password@localhost:5432/cushion_gov"
ANTHROPIC_API_KEY="sk-ant-..."
JWT_SECRET="your-secret-here"
NODE_ENV="development"

# Network access control — comma-separated CIDR ranges (e.g., county VPN/Wi-Fi subnets)
# If unset: allows all in development, warns in production
ALLOWED_IP_RANGES=""

# Kiosk staff PINs — comma-separated SHA-256 hashes of each staff member's PIN
# Generate: echo -n "1234" | sha256sum
# If unset: allows all in development, blocks in production
KIOSK_STAFF_PINS=""

# Fallback AI provider (optional — activates automatic failover if Claude is down)
OPENAI_API_KEY=""

# Failover tuning (optional)
AI_FAILOVER_THRESHOLD="3"       # consecutive failures before switching to fallback
AI_FAILOVER_RESET_MS="60000"    # ms before retrying primary provider after failover
