DATABASE_URL="postgresql://user:password@localhost:5432/cushion_gov"
ANTHROPIC_API_KEY="sk-ant-..."
JWT_SECRET="your-secret-here"
NODE_ENV="development"

# Fallback AI provider (optional — activates automatic failover if Claude is down)
OPENAI_API_KEY=""

# Failover tuning (optional)
AI_FAILOVER_THRESHOLD="3"       # consecutive failures before switching to fallback
AI_FAILOVER_RESET_MS="60000"    # ms before retrying primary provider after failover
