{
  "description": "Mapping of Georgia Gateway (gateway.ga.gov) and Form 297 SNAP fields to Cushion Gov data models. Cushion Gov collects ONLY financial/household data for SNAP calculations — PII (full name, SSN, DOB, address, phone, email) is collected by the caseworker directly in Gateway.",
  "version": "2.0",
  "lastUpdated": "2026-04-01",
  "piiPolicy": "Cushion Gov does NOT collect personally identifiable information. The applicant provides only a first name and last initial for lobby identification. All PII is entered by the caseworker into Georgia Gateway after reviewing the Cushion intake packet.",
  "sections": {
    "applicantIdentification": {
      "gatewayScreen": "Tell Us About the Applicant / Applicant Info",
      "form297Section": "Section 1 — Applicant Information",
      "note": "PII fields are NOT collected by Cushion — caseworker enters these directly in Gateway",
      "fields": [
        { "gatewayField": "First Name", "cushionModel": null, "cushionField": null, "collectedByCushion": false, "note": "Caseworker enters in Gateway" },
        { "gatewayField": "Last Name", "cushionModel": null, "cushionField": null, "collectedByCushion": false, "note": "Caseworker enters in Gateway" },
        { "gatewayField": "Date of Birth", "cushionModel": null, "cushionField": null, "collectedByCushion": false, "note": "Caseworker enters in Gateway" },
        { "gatewayField": "SSN", "cushionModel": null, "cushionField": null, "collectedByCushion": false, "note": "Caseworker enters in Gateway" },
        { "gatewayField": "Street Address", "cushionModel": null, "cushionField": null, "collectedByCushion": false, "note": "Caseworker enters in Gateway" },
        { "gatewayField": "City", "cushionModel": null, "cushionField": null, "collectedByCushion": false, "note": "Caseworker enters in Gateway" },
        { "gatewayField": "State", "cushionModel": null, "cushionField": null, "collectedByCushion": false, "note": "Caseworker enters in Gateway" },
        { "gatewayField": "ZIP Code", "cushionModel": null, "cushionField": null, "collectedByCushion": false, "note": "Caseworker enters in Gateway" },
        { "gatewayField": "Phone Number", "cushionModel": null, "cushionField": null, "collectedByCushion": false, "note": "Caseworker enters in Gateway" },
        { "gatewayField": "Email", "cushionModel": null, "cushionField": null, "collectedByCushion": false, "note": "Caseworker enters in Gateway" },
        { "gatewayField": "Citizenship/Immigration Status", "cushionModel": null, "cushionField": null, "collectedByCushion": false, "note": "Caseworker enters in Gateway" },
        { "gatewayField": "Preferred Language", "cushionModel": "Applicant", "cushionField": "languagePreference", "collectedByCushion": true }
      ],
      "cushionOnlyFields": [
        { "cushionModel": "Applicant", "cushionField": "displayName", "description": "First name + last initial only (e.g., 'Maria G.') — for lobby/queue identification", "collectedByCushion": true },
        { "cushionModel": "Intake", "cushionField": "queueNumber", "description": "Auto-assigned lobby queue number (e.g., 'A-0247')", "collectedByCushion": true }
      ]
    },
    "householdComposition": {
      "gatewayScreen": "Household Composition",
      "form297Section": "Section 2 — Household Members",
      "fields": [
        { "gatewayField": "Member First Name", "cushionModel": null, "cushionField": null, "collectedByCushion": false, "note": "Caseworker enters in Gateway" },
        { "gatewayField": "Member Last Name", "cushionModel": null, "cushionField": null, "collectedByCushion": false, "note": "Caseworker enters in Gateway" },
        { "gatewayField": "Member DOB", "cushionModel": null, "cushionField": null, "collectedByCushion": false, "note": "Cushion collects age range only (e.g., '30-39')" },
        { "gatewayField": "Relationship to Applicant", "cushionModel": "HouseholdMember", "cushionField": "relationshipToApplicant", "collectedByCushion": true },
        { "gatewayField": "Purchase and Prepare Together", "cushionModel": "HouseholdMember", "cushionField": "purchasesAndPreparesTogether", "collectedByCushion": true, "note": "Determines SNAP household membership" },
        { "gatewayField": "Disability Status", "cushionModel": "HouseholdMember", "cushionField": "isDisabled", "collectedByCushion": true }
      ]
    },
    "income": {
      "gatewayScreen": "Income",
      "form297Section": "Section 3 — Income",
      "fields": [
        { "gatewayField": "Income Type", "cushionModel": "IncomeSource", "cushionField": "incomeType", "collectedByCushion": true, "values": ["EMPLOYMENT", "SELF_EMPLOYMENT", "SSI", "SSDI", "SOCIAL_SECURITY", "UNEMPLOYMENT", "CHILD_SUPPORT_RECEIVED", "VA_BENEFITS", "PENSION", "OTHER"] },
        { "gatewayField": "Employer/Payer Name", "cushionModel": "IncomeSource", "cushionField": "employerOrPayerName", "collectedByCushion": true },
        { "gatewayField": "Pay Frequency", "cushionModel": "IncomeSource", "cushionField": "payFrequency", "collectedByCushion": true, "values": ["WEEKLY", "BIWEEKLY", "SEMI_MONTHLY", "MONTHLY"] },
        { "gatewayField": "Gross Amount Per Period", "cushionModel": "IncomeSource", "cushionField": "grossAmountPerPeriod", "collectedByCushion": true }
      ]
    },
    "selfEmployment": {
      "gatewayScreen": "Income (Self-Employment sub-section)",
      "form297Section": "Section 3 — Self-Employment",
      "fields": [
        { "gatewayField": "Gross Receipts", "cushionModel": "IncomeSource", "cushionField": "selfEmploymentGross", "collectedByCushion": true },
        { "gatewayField": "Business Expenses", "cushionModel": "IncomeSource", "cushionField": "selfEmploymentExpenses", "collectedByCushion": true },
        { "gatewayField": "Deduction Method", "cushionModel": "IncomeSource", "cushionField": "selfEmploymentDeductionMethod", "collectedByCushion": true, "values": ["ITEMIZED", "STANDARD_40_PCT"] }
      ]
    },
    "shelterExpenses": {
      "gatewayScreen": "Expenses — Shelter",
      "form297Section": "Section 4 — Shelter Expenses",
      "fields": [
        { "gatewayField": "Rent or Mortgage", "cushionModel": "ShelterExpense", "cushionField": "rentOrMortgage", "collectedByCushion": true },
        { "gatewayField": "Property Tax", "cushionModel": "ShelterExpense", "cushionField": "propertyTax", "collectedByCushion": true },
        { "gatewayField": "Homeowners Insurance", "cushionModel": "ShelterExpense", "cushionField": "homeownersInsurance", "collectedByCushion": true },
        { "gatewayField": "Utility Type", "cushionModel": "ShelterExpense", "cushionField": "utilityType", "collectedByCushion": true, "values": ["HEATING_COOLING", "BASIC", "PHONE_ONLY", "NONE"], "note": "Determines Standard Utility Allowance" }
      ]
    },
    "dependentCare": {
      "gatewayScreen": "Expenses — Dependent Care",
      "form297Section": "Section 4 — Dependent Care",
      "fields": [
        { "gatewayField": "Child Care Cost", "cushionModel": "Intake", "cushionField": "dependentCareExpense", "collectedByCushion": true, "note": "Must be tied to work or training" }
      ]
    },
    "medicalExpenses": {
      "gatewayScreen": "Expenses — Medical",
      "form297Section": "Section 4 — Medical Expenses",
      "fields": [
        { "gatewayField": "Out-of-Pocket Medical", "cushionModel": "Intake", "cushionField": "medicalExpenses", "collectedByCushion": true, "note": "Only for elderly/disabled members; only amount over $35/month" }
      ]
    },
    "childSupport": {
      "gatewayScreen": "Expenses — Child Support",
      "form297Section": "Section 4 — Child Support Paid",
      "fields": [
        { "gatewayField": "Child Support Paid", "cushionModel": "Intake", "cushionField": "childSupportPaid", "collectedByCushion": true, "note": "Legally owed child support paid out" }
      ]
    }
  }
}
